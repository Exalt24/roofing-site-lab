---
import Base from "../layouts/Base.astro";
import { loadDataset } from "../lib/data.ts";
import { ogUrl } from "../lib/img.ts";
const ds = await loadDataset();
const ogFile = (ds.projects.find((p) => p.featured) ?? ds.projects[0])?.photos[0]?.file;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "";
const connected = endpoint !== "";
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
---
<Base ogImage={ogFile ? ogUrl(ogFile) : undefined} title={`Free quote | ${ds.business.name.replace(" (sample)", "")}`} description="Ask for a free roofing quote. Tell us what you are seeing and we will reply the same business day." canonical="/contact/" business={ds.business}>
  <div class="section">
    <h1>Get a free quote</h1>
    <p>Prefer to talk? Call <a href={`tel:${ds.business.telephone}`} data-track="click_to_call">{ds.business.telephone.replace(/^\+1-/, "").replace("-", " ")}</a>.</p>
    {!connected && <p class="notice" role="note"><strong>Sample site:</strong> this quote form is not connected to a lead receiver, so nothing typed here is sent or stored. The receiver is built and tested in the repository but is not deployed for this demo.</p>}
    <form class="lead" method="post" action={connected ? endpoint : undefined} id="lead-form" data-connected={connected ? "yes" : "no"}>
      <p class="muted small-print">Fields marked * are required.</p>
      <label>Your name *<input name="name" autocomplete="name" required aria-required="true" /></label>
      <label>Phone *<input name="phone" type="tel" autocomplete="tel" required aria-required="true" /></label>
      <label>Email (optional)<input name="email" type="email" autocomplete="email" /></label>
      <label>What do you need?
        <select name="service">
          <option value="">Not sure yet</option>
          <option>Leak or repair</option><option>New roof</option><option>Skylight</option><option>Flat roof</option><option>Solar</option><option>Cedar roof</option>
        </select>
      </label>
      <label>Neighbourhood or city (optional)<input name="area" autocomplete="address-level2" /></label>
      <label>What is going on with the roof? *<textarea name="message" rows="4" required></textarea></label>
      <label class="check"><input type="checkbox" name="marketing_opt_in" value="yes" /> Email me occasional roofing tips and offers from {ds.business.legalName}, {ds.business.streetAddress}, {ds.business.city} {ds.business.region} {ds.business.postalCode}, {ds.business.email}. This is optional. You can withdraw your consent at any time with the unsubscribe link in every email.</label>
      <label class="check"><input type="checkbox" name="measurement_opt_in" value="yes" /> Let {ds.business.name.replace(" (sample)", "")} measure its advertising with my request: keep the page I arrived on, the advertisement I clicked and a random Google Analytics visitor number with it, and, if an estimate is booked or this turns into a job, send Google the click, the job value and a scrambled (hashed) copy of my phone number and email. This is optional and does not affect my quote.</label>
      <input type="hidden" name="consent_text_version" value="privacy-2026-10-2" />
      <input type="hidden" name="submission_id" value="" />
      <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="landing_page" value="" />
      <input type="hidden" name="gclid" value="" />
      <input type="hidden" name="click_time" value="" />
      <input type="hidden" name="wbraid" value="" />
      <input type="hidden" name="gbraid" value="" />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="ga_client_id" value="" />
      {turnstile && <div class="cf-turnstile" data-sitekey={turnstile}></div>}
      {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
      <p class="muted small-print">We use your name, phone number, email and the details above to prepare your quote and to contact you about it, We keep your phone number and a scrambled form of your email in our records for 24 months; your name and message reach us as a notification that we keep only as long as we need it to follow up your quote. The advertising box above is separate and optional. See our <a href="/privacy/">privacy page</a>.</p>
      <button class="btn" type="submit" disabled={!connected}>{connected ? "Send" : "Not connected in this sample"}</button>
      <p class="muted small-print" id="lead-status" role="status"></p>
    </form>
  </div>
  <script is:inline>
    (function () {
      var f = document.getElementById("lead-form");
      var q = new URLSearchParams(location.search);
      // this script runs before the layout script, so a NEW ad click arriving on this very page must reset the stored click here too (same rule as the layout script), or it would be paired with the old click time and landing page
      try { var S = sessionStorage, K = ["gclid", "wbraid", "gbraid"], fresh = false; K.forEach(function (k) { var v = q.get(k); if (v && S.getItem("lab_" + k) !== v) fresh = true; }); if (fresh) { K.concat(["utm_source", "utm_medium", "utm_campaign"]).forEach(function (k) { S.removeItem("lab_" + k); }); S.setItem("lab_click_time", new Date().toISOString()); S.setItem("lab_landing", location.href); } } catch (e) {}
      ["gclid", "wbraid", "gbraid", "utm_source", "utm_medium", "utm_campaign"].forEach(function (k) { if (q.get(k)) { f.elements[k].value = q.get(k); try { sessionStorage.setItem("lab_" + k, q.get(k)); } catch (e) {} } else { try { f.elements[k].value = sessionStorage.getItem("lab_" + k) || ""; } catch (e) {} } });
      try { f.elements["landing_page"].value = sessionStorage.getItem("lab_landing") || location.href; } catch (e) { f.elements["landing_page"].value = location.href; } // the page the visitor FIRST landed on, which the layout script recorded
      // when the visitor first arrived from an ad (the first time a click id is seen in this tab), so the 90 and 63 day limits can count from the click and not from the later form
      try { if ((q.get("gclid") || q.get("wbraid") || q.get("gbraid")) && !sessionStorage.getItem("lab_click_time")) sessionStorage.setItem("lab_click_time", new Date().toISOString()); f.elements["click_time"].value = sessionStorage.getItem("lab_click_time") || ""; } catch (e) {}
      function newId() { if (window.crypto && crypto.randomUUID) f.elements["submission_id"].value = crypto.randomUUID(); }
      newId();
      function readGa() { var m = document.cookie.match(/(?:^|; )_ga=GA\d\.\d\.(\d+\.\d+)/); if (m) f.elements["ga_client_id"].value = m[1]; }
      readGa();
      f.addEventListener("submit", function (e) {
        e.preventDefault();
        readGa(); // the cookie may have been set after this page loaded, so it is read again at the moment of sending
        if (f.dataset.connected !== "yes") return;
        // without the measurement box the advertising details never leave the browser (the receiver drops them as well)
        if (!f.elements["measurement_opt_in"].checked) ["landing_page", "gclid", "click_time", "wbraid", "gbraid", "utm_source", "utm_medium", "utm_campaign", "ga_client_id"].forEach(function (k) { f.elements[k].value = ""; });
        var s = document.getElementById("lead-status");
        s.textContent = "Sending...";
        fetch(f.action, { method: "POST", body: new FormData(f) }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); }).then(function (res) {
          if (res.ok) { s.textContent = "Thanks, we have it and will call you back the same business day."; (window.dataLayer = window.dataLayer || []).push({ event: "generate_lead", form_id: "quote" }); f.reset(); newId(); }
          else s.textContent = "That did not go through: " + (res.j.error || "please call us instead") + ".";
        }).catch(function () { s.textContent = "That did not go through, please call us instead."; });
      });
    })();
  </script>
</Base>
